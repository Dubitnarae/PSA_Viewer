# =========================================================
# PSA 입도 뷰어 - .gitignore
# =========================================================

# ---------------------------------------------------------
# 1. 측정 데이터 / 회사 자료 (절대 커밋 금지)
# ---------------------------------------------------------
# 입도분석 결과 파일
*.ngb
*.NGB
*.mea
*.MEA

# 측정 결과 정리 엑셀·CSV·보고서
*.xlsx
*.xls
*.xlsm
*.csv
*.pdf

# 실측 데이터 보관 폴더
samples/
data/
raw/
results/
export/
output/

# 테스트용 더미 파일은 아래 폴더에만 두고 예외로 허용
# (값을 가공한 파일만 넣을 것)
!tests/dummy/
!tests/dummy/**

# ---------------------------------------------------------
# 2. Python
# ---------------------------------------------------------
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# 가상환경
venv/
.venv/
env/
ENV/

# ---------------------------------------------------------
# 3. 빌드 산출물 (exe는 GitHub Releases에 zip으로 첨부)
# ---------------------------------------------------------
build/
dist/
*.exe
*.zip
*.msi
# PyInstaller .spec 파일은 빌드 설정이므로 커밋함 (제외하지 않음)

# ---------------------------------------------------------
# 4. 사용자 설정·로그·임시 파일
# ---------------------------------------------------------
*.log
*.tmp
*.bak
settings.json
config.local.*
recent_files.*

# ---------------------------------------------------------
# 5. 에디터 / OS
# ---------------------------------------------------------
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store
~$*

# Synology / NAS 동기화 부산물
@eaDir/
#recycle/
*.SynologyWorkingDirectory

# 샘플 측정 데이터(.ngb를 base64로 담은 파일) - 실측 데이터이므로 제외
sample.js

# 저장 기능 데이터(측정 원본 사본·데이터 목록·작업 파일) - 실측 데이터이므로 제외
PSA_Data/
*.psa
psa_viewer_settings.json

# Malvern 원본 설치 파일(상용 소프트웨어·매뉴얼) - 리버스 엔지니어링 참고용, 절대 커밋 금지
원본 프로그램/
